# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo nem no chat.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Vercel: variável sem NEXT_PUBLIC). Usada apenas para enviar convites por e-mail.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do sistema (usado nos links de convite e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fase 3 · Integração com o Mercado Pago (só no servidor, sem NEXT_PUBLIC).
# Access Token de PRODUÇÃO de cada conta (mercadopago.com.br/developers > Suas integrações > Credenciais de produção).
# O número (1 a 4) é escolhido na tela da conta, em Contas e saldos.
MERCADOPAGO_ACCESS_TOKEN_1=
MERCADOPAGO_ACCESS_TOKEN_2=
# Senha longa (16+ caracteres) que protege a sincronização diária. A Vercel envia sozinha.
CRON_SECRET=
