# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo nem no chat.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Vercel: variável sem NEXT_PUBLIC). Usada apenas para enviar convites por e-mail.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do sistema (usado nos links de convite e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
